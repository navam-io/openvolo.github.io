---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found — OpenVolo">
  <div class="min-h-screen flex items-center justify-center px-4">
    <div class="text-center">
      <p class="text-8xl font-display font-extrabold text-gradient-brand">404</p>
      <h1 class="mt-4 font-display font-bold text-2xl tracking-tight">Page not found</h1>
      <p class="mt-2 text-muted-foreground">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a
        href="/"
        class="mt-6 inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground shadow-sm hover:opacity-90 transition-opacity"
      >
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        Back to home
      </a>
    </div>
  </div>
</BaseLayout>
