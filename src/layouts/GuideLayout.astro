---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GuideSidebar from "../components/GuideSidebar.astro";
import GuidePrevNext from "../components/GuidePrevNext.astro";

interface Chapter {
  id: string;
  title: string;
  href: string;
}

interface NavItem {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  chapters: Chapter[];
  currentSlug?: string;
  prev?: NavItem;
  next?: NavItem;
}

const { title, description, chapters, currentSlug, prev, next } = Astro.props;

const pageTitle = currentSlug
  ? `${title} — OpenVolo Guide`
  : "User Guide — OpenVolo";
---

<BaseLayout title={pageTitle} description={description}>
  <Header />

  <main id="main" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
    <div class="lg:grid lg:grid-cols-[256px_1fr] lg:gap-8">
      <GuideSidebar chapters={chapters} currentSlug={currentSlug} />

      <article class="min-w-0 max-w-3xl">
        <!-- Breadcrumb -->
        <nav class="mb-6 text-sm text-muted-foreground" aria-label="Breadcrumb">
          <ol class="flex items-center gap-1.5 flex-wrap">
            <li>
              <a href="/" class="hover:text-foreground transition-colors">Home</a>
            </li>
            <li aria-hidden="true">/</li>
            {currentSlug ? (
              <>
                <li>
                  <a href="/guide/" class="hover:text-foreground transition-colors">Guide</a>
                </li>
                <li aria-hidden="true">/</li>
                <li class="text-foreground font-medium truncate">{title}</li>
              </>
            ) : (
              <li class="text-foreground font-medium">Guide</li>
            )}
          </ol>
        </nav>

        <div class="guide-prose">
          <slot />
        </div>

        <GuidePrevNext prev={prev} next={next} />
      </article>
    </div>
  </main>

  <Footer />
</BaseLayout>
