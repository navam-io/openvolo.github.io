---
interface NavItem {
  title: string;
  href: string;
}

interface Props {
  prev?: NavItem;
  next?: NavItem;
}

const { prev, next } = Astro.props;
---

{(prev || next) && (
  <nav class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-4" aria-label="Chapter navigation">
    {prev ? (
      <a
        href={prev.href}
        class="glass-card p-4 group hover:border-primary/40 transition-colors"
      >
        <span class="text-xs text-muted-foreground font-medium uppercase tracking-wider">
          &larr; Previous
        </span>
        <span class="block mt-1 text-sm font-semibold text-foreground group-hover:text-primary transition-colors">
          {prev.title}
        </span>
      </a>
    ) : (
      <div />
    )}

    {next ? (
      <a
        href={next.href}
        class="glass-card p-4 group hover:border-primary/40 transition-colors text-right"
      >
        <span class="text-xs text-muted-foreground font-medium uppercase tracking-wider">
          Next &rarr;
        </span>
        <span class="block mt-1 text-sm font-semibold text-foreground group-hover:text-primary transition-colors">
          {next.title}
        </span>
      </a>
    ) : (
      <div />
    )}
  </nav>
)}
