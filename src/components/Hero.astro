<section id="hero" class="relative min-h-[90vh] flex items-center justify-center overflow-hidden py-24 sm:py-32">
  <!-- Gradient orbs background -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <!-- Cyan orb -->
    <div
      class="absolute top-1/4 left-1/4 w-[500px] h-[500px] rounded-full opacity-30 dark:opacity-20 blur-[100px] animate-float-1"
      style="background: var(--brand-cyan);"
    ></div>
    <!-- Lavender/Pink orb -->
    <div
      class="absolute top-1/3 right-1/4 w-[450px] h-[450px] rounded-full opacity-25 dark:opacity-15 blur-[100px] animate-float-2"
      style="background: linear-gradient(135deg, var(--brand-lavender), var(--brand-pink));"
    ></div>
    <!-- Coral orb -->
    <div
      class="absolute bottom-1/4 right-1/3 w-[400px] h-[400px] rounded-full opacity-20 dark:opacity-15 blur-[100px] animate-float-3"
      style="background: var(--brand-coral);"
    ></div>
  </div>

  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
    <!-- Badge -->
    <div class="reveal mb-6 inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-medium glass">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-cyan opacity-75"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-cyan"></span>
      </span>
      Open Source &middot; Local-First &middot; AI-Native
    </div>

    <!-- Headline -->
    <h1 class="reveal font-display font-extrabold text-4xl sm:text-5xl md:text-6xl lg:text-7xl tracking-tight leading-[1.1]"
        style="animation-delay: 80ms">
      Your <span class="text-gradient-brand">AI-Powered</span><br class="hidden sm:inline" />
      Social CRM
    </h1>

    <!-- Subheadline -->
    <p class="reveal mt-6 text-lg sm:text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed"
       style="animation-delay: 160ms">
      Manage contacts, content, and engagement across X, LinkedIn, and Gmail — powered by Claude AI agents. All data stays on your machine.
    </p>

    <!-- Terminal CTA -->
    <div class="reveal mt-10" style="animation-delay: 240ms">
      <div class="relative inline-block max-w-sm w-full">
        <!-- Shimmer border wrapper -->
        <div class="absolute -inset-px rounded-xl shimmer-border"></div>
        <!-- Terminal block -->
        <div class="relative rounded-xl bg-foreground/95 dark:bg-card terminal-glow px-6 py-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="h-3 w-3 rounded-full bg-red-400/70"></span>
            <span class="h-3 w-3 rounded-full bg-yellow-400/70"></span>
            <span class="h-3 w-3 rounded-full bg-green-400/70"></span>
          </div>
          <div class="flex items-center gap-2 font-mono text-sm sm:text-base">
            <span class="text-brand-cyan select-none">$</span>
            <code class="text-background dark:text-foreground font-medium tracking-wide">npx openvolo</code>
            <span class="ml-auto">
              <button
                id="copy-cmd"
                class="text-muted-foreground hover:text-background dark:hover:text-foreground transition-colors"
                aria-label="Copy command"
                title="Copy to clipboard"
              >
                <!-- Copy icon (default state) -->
                <svg id="copy-icon" class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                  <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
                </svg>
                <!-- Check icon (copied state) -->
                <svg id="copied-icon" class="h-4 w-4 text-green-400 hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </button>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Secondary links -->
    <div class="reveal mt-8 flex flex-wrap items-center justify-center gap-4 text-sm" style="animation-delay: 320ms">
      <a
        href="https://github.com/navam-io/openvolo"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg px-4 py-2.5 font-medium text-muted-foreground hover:text-foreground hover:bg-muted/50 transition-colors"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        View on GitHub
      </a>
      <a
        href="#how-it-works"
        class="inline-flex items-center gap-2 rounded-lg px-4 py-2.5 font-medium text-muted-foreground hover:text-foreground hover:bg-muted/50 transition-colors"
      >
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 16v-4"></path>
          <path d="M12 8h.01"></path>
        </svg>
        Learn More
      </a>
    </div>
  </div>
</section>

<script is:inline>
  document.getElementById("copy-cmd")?.addEventListener("click", async function() {
    try {
      await navigator.clipboard.writeText("npx openvolo");
      var copyIcon = document.getElementById("copy-icon");
      var copiedIcon = document.getElementById("copied-icon");
      if (copyIcon && copiedIcon) {
        copyIcon.classList.add("hidden");
        copiedIcon.classList.remove("hidden");
        setTimeout(function() {
          copyIcon.classList.remove("hidden");
          copiedIcon.classList.add("hidden");
        }, 2000);
      }
    } catch (e) { /* clipboard API not available */ }
  });
</script>
