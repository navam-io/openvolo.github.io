---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border/50 bg-muted/30">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Brand -->
      <div class="space-y-4">
        <a href="#" class="flex items-center gap-2.5">
          <img
            src="/assets/openvolo-logo-transparent.png"
            alt=""
            width="28"
            height="28"
            class="rounded-lg"
          />
          <span class="text-gradient-brand font-display font-bold text-lg tracking-tight">
            OpenVolo
          </span>
        </a>
        <p class="text-sm text-muted-foreground max-w-xs leading-relaxed">
          Agentic AI-Native Social CRM. Manage contacts, content, and engagement — all locally on your machine.
        </p>
      </div>

      <!-- Product links -->
      <div class="space-y-4">
        <h3 class="font-display font-semibold text-sm text-foreground">Product</h3>
        <ul class="space-y-2.5">
          <li>
            <a href="#features" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
              Features
            </a>
          </li>
          <li>
            <a href="#platforms" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
              Platforms
            </a>
          </li>
          <li>
            <a href="#how-it-works" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
              How It Works
            </a>
          </li>
          <li>
            <a href="#faq" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
              FAQ
            </a>
          </li>
        </ul>
      </div>

      <!-- Community links -->
      <div class="space-y-4">
        <h3 class="font-display font-semibold text-sm text-foreground">Community</h3>
        <ul class="space-y-2.5">
          <li>
            <a
              href="https://github.com/navam-io/openvolo"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-muted-foreground hover:text-foreground transition-colors inline-flex items-center gap-1.5"
            >
              <!-- GitHub icon -->
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              GitHub
            </a>
          </li>
          <li>
            <a
              href="https://github.com/navam-io/openvolo/issues"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-muted-foreground hover:text-foreground transition-colors"
            >
              Report an Issue
            </a>
          </li>
          <li>
            <a
              href="https://github.com/navam-io/openvolo/blob/main/LICENSE"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-muted-foreground hover:text-foreground transition-colors"
            >
              Apache 2.0 License
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-6 border-t border-border/50">
      <p class="text-xs text-muted-foreground text-center">
        &copy; {currentYear} OpenVolo. Open source under the Apache License 2.0.
      </p>
    </div>
  </div>
</footer>
