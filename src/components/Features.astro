---
const features = [
  {
    icon: "terminal",
    title: "Zero Install",
    description: "One command to start. npx openvolo sets up everything — database, migrations, and dashboard.",
  },
  {
    icon: "shield",
    title: "Local-First Privacy",
    description: "Your data never leaves your machine. SQLite database with AES-256 encrypted credentials.",
  },
  {
    icon: "users",
    title: "Unified Contacts",
    description: "Cross-platform contact management with automatic deduplication and enrichment scoring.",
  },
  {
    icon: "bot",
    title: "AI Agents",
    description: "Claude AI agents automate engagement, enrichment, and outreach workflows.",
  },
  {
    icon: "share",
    title: "Multi-Platform Publishing",
    description: "Compose and publish across X, LinkedIn, and Gmail from one dashboard.",
  },
  {
    icon: "chart",
    title: "Smart Data",
    description: "Engagement metrics, funnel tracking, and AI-powered contact enrichment.",
  },
];
---

<section id="features" class="py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="reveal text-center max-w-2xl mx-auto mb-16">
      <h2 class="font-display font-bold text-3xl sm:text-4xl tracking-tight">
        Everything you need to <span class="text-gradient-brand">grow your network</span>
      </h2>
      <p class="mt-4 text-muted-foreground text-lg">
        A complete CRM toolkit powered by AI — from contact management to automated engagement.
      </p>
    </div>

    <!-- Feature grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((feature, i) => (
        <div
          class="reveal glass-card p-6 hover:-translate-y-0.5 hover:shadow-lg transition-all duration-300"
          style={`animation-delay: ${i * 80}ms`}
        >
          <!-- Icon -->
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
            {feature.icon === "terminal" && (
              <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="4 17 10 11 4 5"></polyline>
                <line x1="12" x2="20" y1="19" y2="19"></line>
              </svg>
            )}
            {feature.icon === "shield" && (
              <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
            )}
            {feature.icon === "users" && (
              <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            )}
            {feature.icon === "bot" && (
              <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 8V4H8"></path>
                <rect width="16" height="12" x="4" y="8" rx="2"></rect>
                <path d="M2 14h2"></path>
                <path d="M20 14h2"></path>
                <path d="M15 13v2"></path>
                <path d="M9 13v2"></path>
              </svg>
            )}
            {feature.icon === "share" && (
              <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                <polyline points="16 6 12 2 8 6"></polyline>
                <line x1="12" x2="12" y1="2" y2="15"></line>
              </svg>
            )}
            {feature.icon === "chart" && (
              <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 3v16a2 2 0 0 0 2 2h16"></path>
                <path d="m19 9-5 5-4-4-3 3"></path>
              </svg>
            )}
          </div>

          <!-- Content -->
          <h3 class="font-display font-semibold text-lg mb-2">{feature.title}</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
