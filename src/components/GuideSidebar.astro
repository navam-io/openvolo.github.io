---
interface Chapter {
  id: string;
  title: string;
  href: string;
}

interface Props {
  chapters: Chapter[];
  currentSlug?: string;
}

const { chapters, currentSlug } = Astro.props;
---

<aside id="guide-sidebar" class="guide-sidebar hidden lg:block">
  <nav class="glass-card p-4 sticky top-20" aria-label="Guide navigation">
    <a
      href="/guide/"
      class:list={[
        "block px-3 py-2 text-sm font-display font-bold rounded-lg transition-colors mb-2",
        !currentSlug
          ? "bg-primary/10 text-primary"
          : "text-foreground hover:text-primary",
      ]}
    >
      Guide
    </a>

    <ul class="space-y-0.5">
      {chapters.map((chapter) => {
        const isActive = currentSlug === chapter.id;
        return (
          <li>
            <a
              href={chapter.href}
              class:list={[
                "block px-3 py-2 text-sm rounded-lg transition-colors",
                isActive
                  ? "bg-primary/10 text-primary font-semibold"
                  : "text-muted-foreground hover:text-foreground hover:bg-muted/50",
              ]}
              aria-current={isActive ? "page" : undefined}
            >
              {chapter.title}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</aside>

<!-- Mobile sidebar toggle button -->
<button
  id="guide-sidebar-toggle"
  type="button"
  class="lg:hidden fixed bottom-6 right-6 z-40 flex h-12 w-12 items-center justify-center rounded-full bg-primary text-primary-foreground shadow-lg hover:opacity-90 transition-opacity"
  aria-label="Toggle guide navigation"
  aria-expanded="false"
  aria-controls="guide-sidebar"
>
  <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <line x1="3" x2="21" y1="6" y2="6"></line>
    <line x1="3" x2="21" y1="12" y2="12"></line>
    <line x1="3" x2="21" y1="18" y2="18"></line>
  </svg>
</button>

<!-- Mobile sidebar backdrop -->
<div id="guide-sidebar-backdrop" class="lg:hidden hidden fixed inset-0 z-30 bg-black/40" aria-hidden="true"></div>

<script is:inline>
  (function () {
    const toggle = document.getElementById("guide-sidebar-toggle");
    const sidebar = document.getElementById("guide-sidebar");
    const backdrop = document.getElementById("guide-sidebar-backdrop");

    function openSidebar() {
      sidebar?.classList.remove("hidden");
      sidebar?.classList.add(
        "fixed", "inset-y-0", "left-0", "z-40", "w-72", "overflow-y-auto",
        "bg-background", "p-4", "shadow-xl"
      );
      backdrop?.classList.remove("hidden");
      toggle?.setAttribute("aria-expanded", "true");
    }

    function closeSidebar() {
      sidebar?.classList.add("hidden");
      sidebar?.classList.remove(
        "fixed", "inset-y-0", "left-0", "z-40", "w-72", "overflow-y-auto",
        "bg-background", "p-4", "shadow-xl"
      );
      backdrop?.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    }

    toggle?.addEventListener("click", function () {
      var isHidden = sidebar?.classList.contains("hidden");
      if (isHidden) {
        openSidebar();
      } else {
        closeSidebar();
      }
    });

    backdrop?.addEventListener("click", closeSidebar);

    // Close on nav link click (mobile)
    sidebar?.querySelectorAll("a").forEach(function (link) {
      link.addEventListener("click", function () {
        if (window.innerWidth < 1024) {
          closeSidebar();
        }
      });
    });
  })();
</script>
