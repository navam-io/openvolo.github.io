<section id="cta" class="py-24 sm:py-32 relative overflow-hidden">
  <!-- Background accent -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full opacity-15 dark:opacity-10 blur-[100px]"
         style="background: var(--brand-cyan);"></div>
  </div>

  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 text-center">
    <!-- Heading -->
    <div class="reveal">
      <h2 class="font-display font-bold text-3xl sm:text-4xl tracking-tight">
        Start growing your <span class="text-gradient-brand">network today</span>
      </h2>
      <p class="mt-4 text-muted-foreground text-lg">
        One command. No credit card. No cloud account. Just your data, on your machine.
      </p>
    </div>

    <!-- Terminal CTA -->
    <div class="reveal mt-10" style="animation-delay: 80ms">
      <div class="relative inline-block max-w-sm w-full">
        <div class="absolute -inset-px rounded-xl shimmer-border"></div>
        <div class="relative rounded-xl bg-foreground/95 dark:bg-card terminal-glow px-6 py-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="h-3 w-3 rounded-full bg-red-400/70"></span>
            <span class="h-3 w-3 rounded-full bg-yellow-400/70"></span>
            <span class="h-3 w-3 rounded-full bg-green-400/70"></span>
          </div>
          <div class="flex items-center gap-2 font-mono text-sm sm:text-base">
            <span class="text-brand-cyan select-none">$</span>
            <code class="text-background dark:text-foreground font-medium tracking-wide">npx openvolo</code>
          </div>
        </div>
      </div>
    </div>

    <!-- Links -->
    <div class="reveal mt-8 flex flex-wrap items-center justify-center gap-4 text-sm" style="animation-delay: 160ms">
      <a
        href="https://github.com/navam-io/openvolo"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg px-5 py-2.5 font-medium glass hover:-translate-y-0.5 transition-all duration-200"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        View on GitHub
      </a>
      <a
        href="https://github.com/navam-io/openvolo#quick-start"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg px-5 py-2.5 font-medium text-muted-foreground hover:text-foreground transition-colors"
      >
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"></path>
        </svg>
        Documentation
      </a>
    </div>
  </div>
</section>
